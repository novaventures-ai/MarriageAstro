{
  "$schema": "https://static.anthropic.com/mcp/connector-manifest-schema.json",
  "manifest_version": "1.0",
  "name": "Vedic Astrology MCP — MarriageAstro",
  "description": "The world's most complete Vedic astrology MCP server with 22 tools for birth charts, compatibility analysis, divorce risk assessment, spouse prediction, and relationship insights using Swiss Ephemeris.",
  "version": "1.0.0",
  "author": {
    "name": "MarriageAstro",
    "email": "support@marriageastro.com"
  },
  "homepage": "https://marriage-astro.vercel.app",
  "repository": "https://github.com/novaventures-ai/marriageastro",
  "icon": "icon.png",
  "categories": ["lifestyle", "productivity", "data"],
  "tags": [
    "vedic-astrology",
    "kundali",
    "birth-chart",
    "compatibility",
    "marriage",
    "jyotish",
    "navamsa",
    "dasha",
    "horoscope",
    "divorce-risk",
    "spouse-prediction",
    "ashtakoot"
  ],
  "server": {
    "type": "remote",
    "url": "https://marriage-astro.vercel.app/api/mcp",
    "transport": "streamable-http"
  },
  "authentication": {
    "required": true,
    "type": "oauth2",
    "authorization_url": "https://marriage-astro.vercel.app/oauth/authorize",
    "token_url": "https://marriage-astro.vercel.app/api/oauth",
    "scopes": [],
    "pkce_required": true,
    "client_credentials": {
      "note": "Client ID and Secret must be configured by user during connector setup"
    }
  },
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false
  },
  "tools_count": 22,
  "pricing_tiers": {
    "free": {
      "tools": [
        "get_birth_chart",
        "calculate_compatibility",
        "analyze_dosha"
      ],
      "description": "Basic birth chart and compatibility analysis"
    },
    "developer": {
      "tools": [
        "get_full_compatibility_report",
        "get_marriage_timing",
        "get_synastry",
        "get_navamsa_matching",
        "get_kp_analysis",
        "get_jaimini_dasha",
        "get_self_analysis"
      ],
      "description": "Advanced astrological analysis including divisional charts and dasha systems",
      "price_monthly_usd": 9.99
    },
    "premium": {
      "tools": [
        "get_divorce_risk",
        "get_infidelity_risk",
        "get_sexual_compatibility",
        "get_sexual_health",
        "get_mental_health_analysis",
        "get_psychological_profile",
        "get_conflict_zones",
        "get_vulnerability_windows",
        "get_inlaw_analysis",
        "get_spouse_prediction",
        "get_modern_challenges",
        "get_remedies"
      ],
      "description": "Complete relationship analysis including psychological profiles and predictive insights",
      "price_monthly_usd": 19.99
    }
  },
  "security": {
    "data_encryption": "TLS 1.3",
    "token_storage": "user-local",
    "pii_handling": "No PII stored on server; all calculations are stateless",
    "compliance": ["GDPR-ready", "Data minimization principle"]
  },
  "rate_limits": {
    "free": "10 requests/hour",
    "developer": "100 requests/hour",
    "premium": "500 requests/hour"
  },
  "support": {
    "documentation": "https://marriage-astro.vercel.app/docs/mcp",
    "email": "support@marriageastro.com",
    "issues": "https://github.com/novaventures-ai/marriageastro/issues"
  },
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2025-05-20",
      "changes": [
        "Initial release with 22 Vedic astrology tools",
        "OAuth 2.0 with PKCE support",
        "Three-tier pricing: Free, Developer ($9.99/mo), Premium ($19.99/mo)",
        "Unique features: divorce risk, infidelity analysis, sexual compatibility"
      ]
    }
  ]
}
